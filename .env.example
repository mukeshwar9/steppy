DATABASE_URL=postgresql://steppy:steppy@localhost:54329/steppy?schema=public
TEST_DATABASE_URL=postgresql://steppy:steppy@localhost:54329/steppy_test?schema=public
# Production (`pnpm --filter @steppy/api start`) refuses to boot unless this is unique and at least 32 characters.
JWT_ACCESS_SECRET=dev-access-secret-change-me
API_PORT=3000
# Comma-separated browser origins for HTTP and sockets; unset allows all (dev). Required in production
# (native mobile apps send no Origin header, so this only affects browsers).
CORS_ORIGIN=
# Express "trust proxy" for the /auth rate limiter's client IP: unset/false = off, true, a hop count (1) or a subnet.
# Only set it when the API runs behind a reverse proxy you control.
TRUST_PROXY=
DEMO_MODE=true
DEMO_TIMEZONE=America/Los_Angeles
