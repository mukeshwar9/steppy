{
  "expo": {
    "name": "Steppy",
    "slug": "steppy",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "steppy",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.steppy.app"
    },
    "android": {
      "package": "com.steppy.app",
      "permissions": ["android.permission.health.READ_STEPS"]
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      "react-native-health-connect",
      ["expo-build-properties", { "android": { "minSdkVersion": 26, "compileSdkVersion": 36, "targetSdkVersion": 36 } }]
    ]
  }
}
