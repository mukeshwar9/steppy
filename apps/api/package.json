{
  "name": "@steppy/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @steppy/core build",
    "dev": "../../scripts/with-env.sh nest start --watch",
    "prebuild": "pnpm --filter @steppy/core build && prisma generate",
    "build": "tsc -p tsconfig.build.json",
    "start": "../../scripts/with-env.sh node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm --filter @steppy/core build && prisma generate",
    "test": "../../scripts/with-env.sh vitest run",
    "lint": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "../../scripts/with-env.sh prisma migrate deploy",
    "prisma:migrate:dev": "../../scripts/with-env.sh prisma migrate dev",
    "db:seed": "../../scripts/with-env.sh tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.0.1",
    "@nestjs/websockets": "^11.0.1",
    "@prisma/client": "^6.2.1",
    "@steppy/core": "workspace:*",
    "bcryptjs": "^2.4.3",
    "helmet": "^8.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.7",
    "@swc/core": "^1.16.13",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/supertest": "^7.2.1",
    "prisma": "^6.2.1",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.0",
    "tsx": "^4.19.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^3.2.7"
  }
}
